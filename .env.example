# Application
NODE_ENV=production
PORT=7011
HOSTNAME=0.0.0.0

# Docker compose
HOST_PORT=7011
REPLICA_PORT=7015
CONTAINER_PORT=7011
REPLICAS=2
IMAGE_TAG=latest
MEMORY_LIMIT=4G
MEMORY_RESERVATION=512M
NODE_OPTIONS=--max-old-space-size=4096

# Next.js public env vars (baked at build time for NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:7004/sign-in
